/* RewardPanel 스타일 — 게임 테마: 핑크 #ff8a8a, 라벤더 #b885f2 */

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
}

.panel-card {
    background-color: rgb(255, 255, 255);
    border-radius: 32px;
    padding: 56px 60px;
    width: 620px;
    align-items: stretch;
    -unity-font: url("../TextMesh Pro/Fonts/NanumSquareRoundEB.ttf");
}

/* 이모지 */
.emoji {
    font-size: 62px;
    -unity-text-align: upper-center;
    margin-bottom: 4px;
}

/* 제목 */
.title {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: rgb(60, 60, 60);
    margin-bottom: 10px;
}

/* 부제목 */
.subtitle {
    font-size: 20px;
    color: rgb(160, 160, 160);
    -unity-text-align: upper-center;
    margin-bottom: 32px;
}

/* 인증코드 박스 */
.code-box {
    background-color: rgb(245, 237, 255);
    border-radius: 20px;
    padding-top: 26px;
    padding-bottom: 26px;
    margin-bottom: 14px;
    align-items: center;
}

/* 인증코드 텍스트 */
.code-text {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(130, 75, 200);
    -unity-text-align: upper-center;
    letter-spacing: 3px;
}

/* 상태 메시지 (저장 중..., 발급 완료 등) */
.status-text {
    font-size: 17px;
    color: rgb(160, 160, 160);
    -unity-text-align: upper-center;
    margin-bottom: 22px;
    height: 26px;
}

/* 복사 완료 메시지 → 초록색 */
.status-copied {
    color: rgb(60, 190, 100);
}

/* 버튼 공통 */
.btn {
    border-radius: 16px;
    padding-top: 22px;
    padding-bottom: 22px;
    border-width: 0;
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

/* 코드 복사 버튼 — 라벤더 강조 */
.btn-copy {
    background-color: rgb(184, 133, 242);
    color: rgb(255, 255, 255);
}

.btn-copy:hover {
    background-color: rgb(165, 110, 230);
}

.btn-copy:active {
    background-color: rgb(145, 90, 210);
}

/* 계속하기 버튼 — 핑크 */
.btn-primary {
    background-color: rgb(255, 138, 138);
    color: rgb(255, 255, 255);
}

.btn-primary:hover {
    background-color: rgb(255, 110, 110);
}

.btn-primary:active {
    background-color: rgb(230, 90, 90);
}

/* 다시 시도 버튼 — 저장 실패 시에만 노출. 눈에 띄되 강하지 않은 톤 */
.btn-retry {
    background-color: rgb(255, 175, 130);
    color: rgb(255, 255, 255);
}

.btn-retry:hover {
    background-color: rgb(255, 155, 105);
}

.btn-retry:active {
    background-color: rgb(230, 130, 80);
}

/* 1레벨로 버튼 — 외곽선 스타일 */
.btn-secondary {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(190, 190, 190);
    border-width: 2px;
    border-color: rgb(220, 220, 220);
    margin-bottom: 0;
}

.btn-secondary:hover {
    background-color: rgb(245, 245, 245);
}
